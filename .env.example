# Optional: consultation checkout (defaults shown)
# PAYMENT_PROVIDER=mock
# BOOKING_ORDER_EXPIRY_MINUTES=10

# Razorpay (set PAYMENT_PROVIDER=razorpay to enable live checkout)
# Set these on Vercel for Production AND Preview builds (build-time + runtime).
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=your_secret_key
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database backup/restore only (never commit real password)
# Dashboard → Project Settings → Database → Connection string → Session pooler
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=aws-1-ap-northeast-1.pooler.supabase.com
SUPABASE_DB_USER=postgres.your-project-ref

# Optional: full connection string instead of the vars above
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres
